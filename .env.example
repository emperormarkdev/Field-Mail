# ---------------------------------------------------------------------------
# Fieldmail — email configuration
# Copy this file to `.env.local` for local use, or add these 3 variables in
# Vercel → Project Settings → Environment Variables when deploying.
# ---------------------------------------------------------------------------

# 1. The Gmail address that reports are sent from
GMAIL_USER=you@gmail.com

# 2. Your 16-character Gmail App Password
#    Create one at: https://myaccount.google.com/apppasswords
#    (Requires 2-Step Verification enabled on your Google Account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 3. Your Sending Password (any secret password you choose, e.g. my-team-2026)
#    Enter this exact same password inside Fieldmail → Settings → Sending password
ACCESS_KEY=my-secret-password
