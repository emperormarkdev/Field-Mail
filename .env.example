# ---------------------------------------------------------------------------
# SiteReport — server-side environment variables (Vercel → Project Settings → Environment Variables)
# Nothing here is ever read by the browser. Do not commit real values.
# ---------------------------------------------------------------------------

# The Gmail address that reports are sent from.
GMAIL_USER=you@gmail.com

# A 16-character Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
# This is NOT your normal Google password. Spaces in the string are fine, they get stripped.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Shared secret. The app sends this in the X-Access-Key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_KEY=

# Optional hard allowlist. When set, the function refuses to email anyone whose
# address is not in this comma-separated list. Leave empty to allow any recipient.
# ALLOWED_RECIPIENTS=supervisor@example.com,pm@example.com

# ---------------------------------------------------------------------------
# Local development only — used by the client when running `npm run dev`.
# Create a file named `.env.local` (git-ignored) to point the dev server at a real
# access key. In production the key is entered in the app's Settings screen and
# stored on the device, never bundled.
# ---------------------------------------------------------------------------
# VITE_DEV_ACCESS_KEY=
